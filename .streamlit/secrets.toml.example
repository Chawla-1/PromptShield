# Streamlit Secrets Configuration Template
# -------------------------------------------------------------
# For Local Development:
#   Copy this file to .streamlit/secrets.toml (which is git-ignored)
#
# For Streamlit Community Cloud:
#   Paste these contents into:
#   Your App > Manage App (bottom right) > Settings > Secrets
# -------------------------------------------------------------

GEMINI_API_KEY = "your_actual_gemini_api_key_here"
PS_BACKEND = "gemini"
PS_GEMINI_MODEL = "gemini-3.1-flash-lite"
